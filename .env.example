# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=/api/v1
APP_TIMEZONE=Asia/Jakarta

# Database lokal Fase A (Postgres tanpa Docker: npm run db:start, port 5433)
DATABASE_URL="postgresql://spmb:spmb_dev@localhost:5433/spmb"
DIRECT_URL="postgresql://spmb:spmb_dev@localhost:5433/spmb"

# Auth
JWT_SECRET=
ENCRYPTION_KEY=
ADMIN_SEED_USERNAME=superadmin
ADMIN_SEED_PASSWORD=

# Google Drive (dokumen pendaftar). Diisi setelah kredensial OAuth tersedia.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/v1/admin/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER_NAME=SPMB

# Supabase Storage (konten publik + draf-temp)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=konten-publik
SUPABASE_BUCKET_DRAFT=draf-temp


# Gemini (cadangan jawaban Tanya Panitia bila FAQ tidak cocok; kosong = tanpa AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Batas pemanggilan AI per hari untuk seluruh situs (melindungi kuota)
GEMINI_BATAS_HARIAN=300

# Email
RESEND_API_KEY=
RESEND_FROM="SPMB SMK Ma'arif NU 1 Wangon <spmb@smkmanu1wangon.sch.id>"

# Cron (Vercel Cron mengirim Authorization: Bearer <CRON_SECRET>; minimal 16 karakter, kosong = tugas terjadwal mati)
CRON_SECRET=

WA_GROUP_URL=
# Folder berkas sementara wizard saat Supabase belum diisi (hanya dev). Bawaan: .local/draf-temp
DRAF_TEMP_DIR=

# Tes e2e (npm run test:e2e) membaca .env.test, bukan .env. Salin variabel di atas, lalu ubah:
#   DATABASE_URL dan DIRECT_URL -> postgresql://spmb:spmb_dev@localhost:5433/spmb_e2e_test (bukan spmb_test: tes unit mengosongkannya)
#   NEXT_PUBLIC_SITE_URL        -> http://localhost:3100
#   kosongkan kunci layanan luar: SUPABASE_*, NEXT_PUBLIC_SUPABASE_*, GOOGLE_DRIVE_CLIENT_*, GOOGLE_CLOUD_VISION_API_KEY,
#   GEMINI_API_KEY, RESEND_API_KEY (server dev Next tetap membaca .env, jadi harus dikosongkan eksplisit).
# Siapkan database tes sekali: npm run db:start && npm run db:test:siapkan

# Cadangan database (npm run db:backup): taruh alamat database yang dicadangkan di berkas .env.backup (tidak di-commit), mis.
#   DIRECT_URL="postgresql://postgres.xxxx:PASSWORD_DIKODE@aws-0-....pooler.supabase.com:5432/postgres"   (Session pooler, port 5432)
# Hasil cadangan memuat data pribadi: disimpan di luar folder proyek (BACKUP_DIR, bawaan ../backup-spmb). Simpan ENCRYPTION_KEY terpisah.
# BACKUP_DIR=

