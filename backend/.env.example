APP_NAME="SPMB SMK Ma'arif NU 1 Wangon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dev lokal: Postgres dari infra/docker-compose.dev.yml (port 5433).
# Produksi/Supabase: pakai host Session Pooler (port 5432) dari dashboard, user postgres.<PROJECT_REF>, DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=spmb
DB_USERNAME=spmb
DB_PASSWORD=spmb_dev
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Konten publik (Supabase Storage, bucket konten-publik)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_BUCKET_PUBLIC=konten-publik
SUPABASE_PUBLIC_URL=

# Dokumen pendaftar: google_drive (produksi) | lokal (dev & test)
DOKUMEN_DRIVER=lokal
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/admin/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER_NAME=SPMB
# Refresh token TIDAK ditaruh di .env: disimpan terenkripsi di tabel pengaturans
# setelah php artisan spmb:drive-hubungkan.

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="spmb@smkmanu1wangon.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

OCR_SERVICE_URL=http://localhost:8001
OCR_SERVICE_TOKEN=
OCR_TIMEOUT=90

DRAFT_TTL_DAYS=7
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

ADMIN_SEED_USERNAME=superadmin
ADMIN_SEED_PASSWORD=

WA_GROUP_URL=
